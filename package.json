{
  "name": "zalo-mcp",
  "version": "1.6.2",
  "description": "CLI tool for Zalo automation — multi-account, proxy, bank transfers, QR payments, Official Account API v3.0",
  "type": "module",
  "bin": {
    "zalo-agent": "src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/test-fixtures.ts",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "build:bin": "bun build ./src/index.ts --compile --outfile dist/zalo-agent",
    "release": "bun pm version patch -m 'release: v%s' && git push origin main --tags",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "keywords": [
    "zalo",
    "cli",
    "automation",
    "messaging",
    "vietnam",
    "proxy",
    "vietqr",
    "zca-js",
    "official-account",
    "zalo-oa",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuongtranba/zalo-agent-cli.git"
  },
  "homepage": "https://github.com/cuongtranba/zalo-agent-cli#readme",
  "bugs": {
    "url": "https://github.com/cuongtranba/zalo-agent-cli/issues"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "https-proxy-agent": "^8.0.0",
    "zca-js": "^2.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "oxlint": "1.91.0",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
